# PostgreSQL connection string.
# Local dev matches docker-compose.yml below; in Coolify use the internal Postgres hostname.
DATABASE_URL=postgres://intern:intern@localhost:5432/intern
# Better Auth: a long random secret (openssl rand -base64 32) and the app's public URL.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# First coordinator account, created on first run if it does not exist yet.
COORDINATOR_EMAIL=coordinator@example.com
COORDINATOR_PASSWORD=change-me
COORDINATOR_NAME=Coordinator
